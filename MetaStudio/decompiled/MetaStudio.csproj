<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>MetaStudio</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net45</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <Reference Include="SunnyUI">
      <HintPath>../app/SunnyUI.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration">
      <HintPath>../../../.local/dotnet/shared/Microsoft.NETCore.App/10.0.10/System.Configuration.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.Core">
      <HintPath>../../../.local/dotnet/shared/Microsoft.NETCore.App/10.0.10/System.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>../app/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="CaptureImageTool">
      <HintPath>../app/CaptureImageTool.dll</HintPath>
    </Reference>
    <Reference Include="SunnyUI.Common">
      <HintPath>../app/SunnyUI.Common.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>